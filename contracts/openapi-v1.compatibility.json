{
  "version": 1,
  "operations": [
    "GET /oauth/authorize",
    "POST /oauth/authorize",
    "POST /oauth/token",
    "GET /profile",
    "PATCH /profile",
    "GET /goals",
    "POST /goals",
    "GET /tasks",
