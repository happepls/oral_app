{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guajiguaji.top/schemas/quality-report.json",
  "type": "object",
  "required": ["run_id", "generated_at", "scores", "category_scores", "final_score", "findings", "decision"],
  "properties": {
    "run_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scores": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 } },
    "category_scores": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 40 } } },
    "final_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "decision": { "enum": ["pass", "auto_fix", "manual", "hard_failure"] },
    "round": { "type": "integer", "minimum": 0, "maximum": 3 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "domain", "expected", "actual", "confidence", "auto_fix_allowed", "severity"],
        "properties": {
          "rule_id": { "type": "string" },
          "domain": { "enum": ["frontend", "backend", "integration"] },
          "category": { "type": "string" },
          "severity": { "enum": ["info", "minor", "major", "critical"] },
          "hard_blocker": { "type": "string" },
          "target": { "type": "string" },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "suggested_files": { "type": "array", "items": { "type": "string" } },
          "auto_fix_allowed": { "type": "boolean" }
        }
      }
    }
  }
}
